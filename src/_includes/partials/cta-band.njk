<section class="cta-banner">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <h2>{{ ctaHeading or "When did you last test your smoke alarms?" }}</h2>
        <p class="cta-sub">{{ ctaSub or "If you had to stop and think about it, it's time. One visit and every alarm in the house is sorted for the next ten years." }}</p>
      </div>
      <div class="col-lg-4 text-lg-end">
        <a href="tel:{{ business.phoneTel }}" class="btn-cta-white me-2 mb-2"><i class="fas fa-phone"></i> {{ business.phoneDisplay }}</a>
        <a href="/contact/#quote" class="btn-cta-outline mb-2"><i class="fas fa-file-lines"></i> Get a Quote</a>
      </div>
    </div>
  </div>
</section>
