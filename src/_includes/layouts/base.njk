<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ business.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ business.url }}{{ page.url }}">
  {%- set ogImg = images[imgKey].hero if imgKey and images[imgKey] else null %}
  {%- if ogImg %}
  <meta property="og:image" content="{{ business.url }}{{ ogImg.file }}">
  {%- endif %}

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/style.css?v={{ assetVersion }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Electrician",
    "@id": "{{ business.url }}/#business",
    "name": "{{ business.name }}",
    "description": "Photoelectric smoke alarm installation, replacement, testing and rental compliance across Christchurch and Canterbury. EWRB registered electricians.",
    "telephone": "{{ business.phoneTel }}",
    "email": "{{ business.email }}",
    "url": "{{ business.url }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ business.addressLine1 }}",
      "addressLocality": "{{ business.city }}",
      "postalCode": "{{ business.postcode }}",
      "addressCountry": "{{ business.countryCode }}"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ business.latitude }},
      "longitude": {{ business.longitude }}
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "07:30", "closes": "17:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "08:00", "closes": "13:00" }
    ],
    "priceRange": "{{ business.priceRange }}",
    "areaServed": { "@type": "City", "name": "Christchurch" }
  }
  </script>
  {%- block schema %}{% endblock %}
</head>
<body>

<div class="top-bar">
  <div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center">
      <div class="top-bar-left d-none d-md-flex align-items-center gap-3">
        <span><i class="fas fa-phone"></i><a href="tel:{{ business.phoneTel }}">{{ business.phoneDisplay }}</a></span>
        <span><i class="fas fa-bell"></i>Photoelectric Alarms • Fitted Same Week</span>
      </div>
      <div class="top-bar-right">
        <a href="/contact/#quote" class="btn-topbar">Get a Free Quote</a>
      </div>
    </div>
  </div>
</div>

<nav class="navbar navbar-expand-lg main-navbar sticky-top" aria-label="Main navigation">
  <div class="container">
    <a class="logo-wrap navbar-brand" href="/" aria-label="{{ business.name }}">
      <div class="logo-icon"><i class="fas fa-bell"></i></div>
      <div class="logo-text">
        <span class="brand-top">Smoke Alarm <span class="accent">Installation</span></span>
        <span class="brand-city">Christchurch</span>
      </div>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link{% if page.url == '/' %} active{% endif %}" href="/">Home</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Services</a>
          <ul class="dropdown-menu">
            {%- for service in services %}
            <li><a class="dropdown-item" href="/{{ service.slug }}/">{{ service.name }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/how-it-works/' %} active{% endif %}" href="/how-it-works/">How It Works</a></li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/pricing/' %} active{% endif %}" href="/pricing/">Pricing</a></li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/faqs/' %} active{% endif %}" href="/faqs/">FAQs</a></li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/about/' %} active{% endif %}" href="/about/">About Us</a></li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/service-areas/' %} active{% endif %}" href="/service-areas/">Service Areas</a></li>
        <li class="nav-item"><a class="nav-link{% if page.url == '/contact/' %} active{% endif %}" href="/contact/">Contact</a></li>
      </ul>
      <div class="d-flex align-items-center gap-3">
        <a href="tel:{{ business.phoneTel }}" class="nav-phone d-none d-xl-flex"><i class="fas fa-phone"></i>{{ business.phoneDisplay }}</a>
        <a href="/contact/#quote" class="btn-nav-cta">Book an Install</a>
      </div>
    </div>
  </div>
</nav>

{{ content | safe }}

<footer class="footer">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4 col-md-6">
        <div class="footer-logo-wrap">
          <div class="footer-logo-icon"><i class="fas fa-bell"></i></div>
          <div class="footer-brand-name">Smoke Alarm Installation<br>Christchurch</div>
        </div>
        <p>Local, EWRB registered electricians installing photoelectric smoke alarms in homes and rentals across Christchurch and Canterbury. One visit, tidy work, and alarms you can forget about for the next ten years.</p>
      </div>
      <div class="col-lg-3 col-md-6">
        <h5>Our Services</h5>
        <ul class="footer-links">
          {%- for service in services %}
          <li><a href="/{{ service.slug }}/">{{ service.name }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="col-lg-2 col-md-6">
        <h5>Quick Links</h5>
        <ul class="footer-links">
          <li><a href="/how-it-works/">How It Works</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/service-areas/">Service Areas</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="col-lg-3 col-md-6">
        <h5>Get in Touch</h5>
        <div class="footer-contact-item"><i class="fas fa-phone"></i><a href="tel:{{ business.phoneTel }}">{{ business.phoneDisplay }}</a></div>
        <div class="footer-contact-item"><i class="fas fa-envelope"></i><a href="mailto:{{ business.email }}">{{ business.email }}</a></div>
        <div class="footer-contact-item"><i class="fas fa-location-dot"></i><span>{{ business.addressLine1 }}, {{ business.suburb }},<br>{{ business.city }} {{ business.postcode }}</span></div>
        <div class="footer-contact-item"><i class="fas fa-clock"></i><span>Mon–Fri 7:30am–5:30pm<br>Sat 8:00am–1:00pm</span></div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <p>© {% year %} {{ business.name }}. All rights reserved.</p>
        <p>EWRB Registered Electricians • Servicing Christchurch &amp; Canterbury</p>
      </div>
    </div>
  </div>
</footer>

<div class="sticky-call-bar d-md-none">
  <i class="fas fa-phone"></i>
  <a href="tel:{{ business.phoneTel }}">Call Now — {{ business.phoneDisplay }}</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/main.js?v={{ assetVersion }}"></script>
</body>
</html>
